# Copy to .env.local (dev) or .env (Docker Compose) and fill values. Never commit real secrets.

# Storage: SQLite (WAL). Compose mounts ./data -> /app/data.
DATABASE_PATH=./data/tokenlens.sqlite

# Sync server address. Must be loopback unless a TLS proxy (Caddy) sits in
# front; inside Docker set 0.0.0.0:8787 and LISTEN_ALLOW_NON_LOOPBACK=1, and
# publish the port on 127.0.0.1 only.
LISTEN_ADDR=127.0.0.1:8787
# LISTEN_ALLOW_NON_LOOPBACK=1

# Server log level (tracing EnvFilter syntax). Logs never contain tokens,
# pairing codes or event bodies at any level.
# RUST_LOG=info

# Day/month bucketing and display timezone
DASHBOARD_TIMEZONE=Asia/Shanghai

# Cost estimates (D042). Public price catalogs (LiteLLM, OpenRouter,
# models.dev) are kept in the server's own tokscale folder, by default
# `tokscale/` next to the database, and downloaded once a day.
# PRICING_DIR=./data/tokscale
# Set to off where the server must not reach the internet; costs then stay
# unpriced until catalogs are copied into PRICING_DIR/cache by hand.
# PRICING_REFRESH=on

# Devices are added with one-time pairing codes, not with tokens configured
# here: run `tokenlens-server pair-code create` for the first device, then use
# the app's Devices page. The server stores only token hashes in the DB.
# Web login (password, session secret) is deferred to the P7 web version.

# Optional, `scripts/reconcile` only: compare numbers with a Token Monitor Hub
# (read-only GET). The dashboard server never reads from or writes to the Hub.
# TOKEN_MONITOR_HUB_URL=https://hub.example.com
TOKEN_MONITOR_HUB_SECRET=

# Optional: deployment / branding
DASHBOARD_APP_NAME=TokenLens

# Desktop updater packaging (D046): shell/CI environment only, not dotenv.
# TOKENLENS_UPDATER_ARTIFACTS defaults to 0; the release workflow sets it to 1
# to create signed updater assets. Ordinary local builds require no key.
# TAURI_SIGNING_PRIVATE_KEY and TAURI_SIGNING_PRIVATE_KEY_PASSWORD are supplied
# by GitHub Actions Secrets. Never put their values in this file or any dotenv
# file, source code, command output, or logs.
# CARGO_TARGET_DIR may select external build storage; bundle scripts use -j 4.
