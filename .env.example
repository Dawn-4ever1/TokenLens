# Copy to .env.local (dev) or .env (Docker Compose) and fill values. Never commit real secrets.

# Storage: SQLite (WAL). Compose mounts ./data -> /app/data.
DATABASE_PATH=./data/tokenlens.sqlite

# Sync server address. Must be loopback unless a TLS proxy (Caddy) sits in
# front; inside Docker set 0.0.0.0:8787 and LISTEN_ALLOW_NON_LOOPBACK=1, and
# publish the port on 127.0.0.1 only.
LISTEN_ADDR=127.0.0.1:8787
# LISTEN_ALLOW_NON_LOOPBACK=1

# Server log level (tracing EnvFilter syntax). Logs never contain tokens,
# pairing codes or event bodies at any level.
# RUST_LOG=info

# Day/month bucketing and display timezone
DASHBOARD_TIMEZONE=Asia/Shanghai

# Cost estimates (D042). Public price catalogs (LiteLLM, OpenRouter,
# models.dev) are kept in the server's own tokscale folder, by default
# `tokscale/` next to the database, and downloaded once a day.
# PRICING_DIR=./data/tokscale
# Set to off where the server must not reach the internet; costs then stay
# unpriced until catalogs are copied into PRICING_DIR/cache by hand.
# PRICING_REFRESH=on

# Devices are added with pairing codes, not with tokens configured here: run
# `tokenlens-server pair-code create` for the first device, then use the app's
# Devices page. The server stores only token hashes in the DB.

# Account sign-in (D049). GitHub sign-in (device flow) is the recommended path
# and needs no client secret: create a GitHub App (Settings -> Developer
# settings -> GitHub Apps), tick "Enable Device Flow", grant Account
# permissions -> Email addresses (Read), and disable webhooks/repository
# permissions. Put its client id here; users enter a short code on
# github.com/login/device. Without it, GitHub buttons answer "unavailable".
# TOKENLENS_GITHUB_CLIENT_ID=

# Google sign-in (D051) uses a web authorization-code flow with PKCE, because
# Google has no device-code flow for desktop apps. In Google Cloud Console
# create an OAuth client of type "Web application" and register the redirect
# URI below; the consent screen needs the openid/email/profile scopes. Both
# values stay on the server only; without them the Google endpoints answer
# "service unavailable". Never commit real values.
# TOKENLENS_GOOGLE_CLIENT_ID=
# TOKENLENS_GOOGLE_CLIENT_SECRET=
# TOKENLENS_GOOGLE_REDIRECT_URI=https://tokenlens.online/api/auth/google/callback

# Email sign-in is the fallback: a 6-digit code by mail; a first sign-in
# creates the person's own space. Leave these unset on a server that should
# not send mail: the sign-in endpoints then answer "service unavailable"
# instead of pretending a code was sent. Never commit real values.
# TOKENLENS_EMAIL_API_KEY=
# TOKENLENS_EMAIL_FROM=TokenLens <login@example.com>
# TOKENLENS_EMAIL_API_URL=https://api.resend.com/emails

# Reversible protection for a space's long-lived pairing code, so a signed-in
# member can see it again. Generate once with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Without it, showing the persistent code answers "service unavailable"; the
# one-time operator codes keep working either way.
# TOKENLENS_PAIRING_KEY=

# Optional collector source overrides (normally not needed; do not point these
# at the other edition). QODER_HOME is the application-support directory;
# QODER_DB_PATH may name the IDE local.db directly. CN uses its own pair.
# QODER_HOME=
# QODER_DB_PATH=
# QODER_CN_HOME=
# QODER_CN_DB_PATH=
# QODERCN_CONFIG_DIR=

# Optional, `scripts/reconcile` only: compare numbers with a Token Monitor Hub
# (read-only GET). The dashboard server never reads from or writes to the Hub.
# TOKEN_MONITOR_HUB_URL=https://hub.example.com
# TOKEN_MONITOR_HUB_SECRET=

# Private operator link for aggregate website counts (schema v13). The server
# records only daily page/download counts and never stores IPs, user agents or
# cookies. Generate once with `openssl rand -hex 24`; leave unset to disable
# /stats/{token}. The token is a URL path segment, not a login password.
# TOKENLENS_STATS_TOKEN=

# Public release mirror (D056). When RELEASE_MIRROR_DIR is set, the official
# server anonymously mirrors the complete signed GitHub Release and serves the
# website downloads and a backup updater manifest. Compose sets
# RELEASE_MIRROR_DIR=/app/downloads; set RELEASE_MIRROR_PUBLIC_BASE in .env to
# enable the mirror in Compose, or leave unset in local development.
# RELEASE_MIRROR_DIR=./downloads
# RELEASE_MIRROR_PUBLIC_BASE=https://tokenlens.online

# Desktop updater packaging (D046): shell/CI environment only, not dotenv.
# TOKENLENS_UPDATER_ARTIFACTS defaults to 0; the release workflow sets it to 1
# to create signed updater assets. Ordinary local builds require no key.
# TAURI_SIGNING_PRIVATE_KEY and TAURI_SIGNING_PRIVATE_KEY_PASSWORD are supplied
# by GitHub Actions Secrets. Never put their values in this file or any dotenv
# file, source code, command output, or logs.
# CARGO_TARGET_DIR may select external build storage; bundle scripts use -j 4.
