{
  "name": "tokenlens-app",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:setup": "node -e \"process.env.PLAYWRIGHT_BROWSERS_PATH = '.playwright-browsers'; require('node:child_process').execSync('npx playwright install webkit', { stdio: 'inherit' })\"",
